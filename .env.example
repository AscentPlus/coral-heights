# Django Core Settings
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=coralheights.in,www.coralheights.in,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://coralheights.in,https://www.coralheights.in,http://localhost:8005,http://127.0.0.1:8005

# Database Settings
# For PostgreSQL: postgres://user:password@localhost:5432/coral_heights_db
# For SQLite (local dev fallback if left unset): sqlite:///db.sqlite3
DATABASE_URL=postgres://postgres:changeme@localhost:5432/coral_heights_db

# Security & SSL Settings (Set to True in Production behind HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Gateways (Set ALLOW_MOCK_PAYMENT=True only in development/testing if DEBUG=False)
ALLOW_MOCK_PAYMENT=False
