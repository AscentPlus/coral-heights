# ==============================================================================
# Hotel Coral Heights — Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with production values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
# Secret key: In production, generate a cryptographically strong, unique key.
# Missing or insecure keys raise ImproperlyConfigured when DEBUG is False.
SECRET_KEY=your-production-secret-key-here

# Debug mode: Always set to False in production.
DEBUG=False

# Allowed hosts: Comma-separated domain names / hostnames (do not include ports).
ALLOWED_HOSTS=demo.example.com,www.demo.example.com,localhost,127.0.0.1

# CSRF trusted origins: Full scheme and domain for trusted origins (must start with https:// in production).
CSRF_TRUSTED_ORIGINS=https://demo.example.com,https://www.demo.example.com

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# In production (DEBUG=False), DATABASE_URL is strictly REQUIRED; leaving it unset
# raises ImproperlyConfigured to prevent accidental fallback to SQLite and data loss.
# PostgreSQL format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:changeme@localhost:5432/coral_heights_db

# ------------------------------------------------------------------------------
# Security & SSL / HTTPS Settings
# ------------------------------------------------------------------------------
# SECURE_SSL_REDIRECT defaults to True in production.
# IMPORTANT: Nginx / reverse proxy MUST send "proxy_set_header X-Forwarded-Proto $scheme;"
# otherwise Django cannot detect HTTPS and an infinite redirect loop will occur.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HSTS settings: Defaults to 3600 seconds and preload=False for safe initial deployment.
# Raise SECURE_HSTS_SECONDS (e.g. 31536000) and set SECURE_HSTS_PRELOAD=True once HTTPS
# is verified stable on the permanent domain.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# ------------------------------------------------------------------------------
# Email Settings
# ------------------------------------------------------------------------------
# Backend defaults to console backend when DEBUG=True, and SMTP when DEBUG=False.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=smtp-user@example.com
EMAIL_HOST_PASSWORD=smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@demo.example.com

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Root logging level output to console (INFO, WARNING, ERROR, DEBUG).
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Cache Configuration
# ------------------------------------------------------------------------------
# Defaults to local memory in dev, and database cache in production so multi-worker
# Gunicorn processes share OTP rate-limiting state. Run 'python manage.py createcachetable'
# if using database cache.
# Examples: dbcache://cache_table, redis://127.0.0.1:6379/1, locmemcache://
CACHE_URL=dbcache://cache_table

# ------------------------------------------------------------------------------
# Client IP Header
# ------------------------------------------------------------------------------
# Header used by reverse proxies to identify the end-user's IP for OTP rate-limiting.
# Use HTTP_CF_CONNECTING_IP behind Cloudflare, or HTTP_X_FORWARDED_FOR behind Nginx
# (where the last hop added by Nginx is trusted). Falls back to REMOTE_ADDR if unset.
CLIENT_IP_HEADER=HTTP_X_FORWARDED_FOR

# ------------------------------------------------------------------------------
# Demo & Testing Flags (Demo Mode Only — Remove for Final Production)
# ------------------------------------------------------------------------------
# DEMO_SHOW_OTP: When True, send_otp returns debug_otp in the JSON response even when
# DEBUG=False, allowing end-to-end booking verification during demos without a live SMS gateway.
# MUST BE REMOVED / SET TO False when a real SMS gateway is connected.
DEMO_SHOW_OTP=False

# ALLOW_MOCK_PAYMENT: Required for the booking demo's mock payment gateway when DEBUG=False.
# MUST BE REMOVED / SET TO False when live Razorpay integration is deployed.
ALLOW_MOCK_PAYMENT=False
